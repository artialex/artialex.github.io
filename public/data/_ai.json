type":"text","text":"automation of entire processes"}]}]}},"parentId":"page:page","index":"a23dEkPU","typeName":"shape"},"shape:gM-EUi8vd3rXHUdVJRNRT":{"x":-115.742883923156,"y":38.88229048321176,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:gM-EUi8vd3rXHUdVJRNRT","type":"text","props":{"color":"black","size":"m","w":859,"font":"draw","textAlign":"start","autoSize":false,"scale":1,"richText":{"type":"doc","content":[{"type":"heading","attrs":{"dir":"auto","level":3},"content":[{"type":"text","text":"Create Mental Model / Cheat Sheet"}]},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Create a scientifically accurate, information-dense mental model image / cheat sheet / visual summary for the topic: \"{TOPIC}\"."}]},{"type":"orderedList","attrs":{"start":1,"type":null},"content":[{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Focus on understanding, not decoration. The image should help someone reconstruct the concept from memory after a quick glance."}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Organize information into 3-7 major sections, moving from the most fundamental ideas to more advanced details. Make the hierarchy visually obvious."}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Include the core entities, their relationships, and the flow between them (cause → effect, input → process → output, hierarchy, cycle, pipeline, etc.)."}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Favor diagrams, arrows, labeled boxes, tables, and small illustrations over long paragraphs. Every visual element should communicate information."}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Add the essential terminology and definitions, but keep text concise (1-2 lines per concept). Avoid unnecessary explanations."}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Show the mental model behind the topic: what should a person imagine happening internally? Prefer physical or intuitive analogies when they improve understanding."}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Include the most important formulas, rules, heuristics, or laws (if applicable), together with a short explanation of when they are used."}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Highlight common confusions, edge cases, exceptions, and misconceptions in a separate \"Pitfalls\" or \"Don't confuse with...\" section."}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Optimize for high information density similar to an engineering cheat sheet, textbook diagram, or educational infographic. Avoid empty decorative space, marketing style, and oversized titles."}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"The final image should feel like a page from a university textbook or a professional reference card: clean layout, scientifically accurate, internally consistent, readable at a glance, and useful both for first-time learning and rapid revision."}]}]}]},{"type":"paragraph","attrs":{"dir":"auto"}},{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Optional style modifiers (can be appended depending on the topic):"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"italic"}],"text":"Use a white background and textbook-style vector graphics."}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"italic"}],"text":"Prefer realistic scientific illustrations over cartoon art."}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"italic"}],"text":"Use consistent color coding for related concepts."}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"italic"}],"text":"Label every important component directly on the image."}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"italic"}],"text":"If the topic is procedural, represent it as a pipeline or state machine."}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"italic"}],"text":"If the topic is hierarchical, represent it as a tree."}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"italic"}],"text":"If the topic involves interactions, represent it as a network graph."}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","marks":[{"type":"italic"}],"text":"If the topic is about software engineering, use architecture diagrams and data-flow arrows rather than mascots or decorative icons."}]}]}]}]}},"parentId":"page:NREdUrK9DOY_G4ZlFg-iA","index":"a1","typeName":"shape"},"shape:2Z33VbHJCw1vCrFpuO41H":{"x":368.7878880587633,"y":279.5978882465803,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:2Z33VbHJCw1vCrFpuO41H","type":"text","props":{"color":"black","size":"m","w":725.75,"font":"draw","textAlign":"start","autoSize":true,"scale":1,"richText":{"type":"doc","content":[{"type":"heading","attrs":{"dir":"auto","level":1},"content":[{"type":"text","text":"Not yet"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"it makes it trivial to create simple, unopinionated things from scratch"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"it has questionable results when working on huge applications with a lot of requirements"}]}]}]}]},{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"people see LLMs as magic, but it's just a bunch of matrix multiplications"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"it's just a tool that makes it easier to find and structure information, it does not have a "},{"type":"text","marks":[{"type":"italic"}],"text":"taste"}]}]}]}]}]}]}},"parentId":"page:QueziZ5Jl_iGJ63UyiOTW","index":"a1","typeName":"shape"},"shape:DTZk2MwMN7QbrhvTggcFM":{"x":672.5869398192698,"y":94.96138934199143,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:DTZk2MwMN7QbrhvTggcFM","type":"text","props":{"color":"black","size":"m","w":359.6333312988281,"font":"draw","textAlign":"middle","autoSize":true,"scale":1,"richText":{"type":"doc","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"Retrieval-Augmented Generation (RAG)"}]}]}},"parentId":"page:page","index":"a1zTqNg6","typeName":"shape"},"shape:MDCskXF_B4cM1RiOF36_0":{"x":102.55360699456276,"y":188.96138934199143,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:MDCskXF_B4cM1RiOF36_0","type":"text","props":{"color":"black","size":"m","w":141.6999969482422,"font":"draw","textAlign":"middle","autoSize":true,"scale":1,"richText":{"type":"doc","content":[{"type":"paragraph","attrs":{"dir":"auto"},"content":[{"type":"text","text":"convolution n.n."}]}]}},"parentId":"page:page","index":"a20c2e3e","typeName":"shape"},"shape:ww72xGiO9UROn6bvu_IUE":{